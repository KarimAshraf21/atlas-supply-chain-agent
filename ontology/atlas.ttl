atlas:Organization a owl:Class ;
    rdfs:label "شركة"@ar,
        "منظمة"@ar,
        "Organization"@en ;
    rdfs:comment "Any legal entity participating in the supply network."@en .

atlas:RiskEvent a owl:Class ;
    rdfs:label "أزمة"@ar,
        "اضطراب"@ar,
        "خطر"@ar,
        "مخاطر"@ar,
        "RiskEvent"@en ;
    rdfs:comment "Real-world event that can disrupt supply, logistics or demand."@en .

atlas:Contract a owl:Class ;
    rdfs:label "اتفاقية"@ar,
        "عقد"@ar,
        "عقود"@ar,
        "Contract"@en ;
    rdfs:comment "Commercial agreement with a supplier, customer or carrier."@en .

atlas:Facility a owl:Class ;
    rdfs:label "منشأة"@ar,
        "موقع"@ar,
        "Facility"@en ;
    rdfs:comment "A physical site."@en .

atlas:Port a owl:Class ;
    rdfs:label "الميناء"@ar,
        "ميناء"@ar,
        "Port"@en ;
    rdfs:comment "Sea or air port; key is UN/LOCODE."@en .

atlas:Product a owl:Class ;
    rdfs:label "منتج"@ar,
        "منتجات"@ar,
        "Product"@en ;
    rdfs:comment "Finished good sold to customers."@en ;
