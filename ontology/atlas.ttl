atlas:Tariff a owl:Class ;
    rdfs:label "تعريفة"@ar,
        "جمارك"@ar,
        "رسوم جمركية"@ar,
        "Tariff"@en ;
    rdfs:comment "Import duty imposed by a country on goods from an origin."@en .

atlas:Chokepoint a owl:Class ;
    rdfs:label "قناة"@ar,
        "مضيق"@ar,
        "ممر ملاحي"@ar,
        "Chokepoint"@en ;
    rdfs:comment "Maritime passage whose disruption forces rerouting."@en .

atlas:Country a owl:Class ;
    rdfs:label "بلد"@ar,
        "دولة"@ar,
        "Country"@en ;
    rdfs:comment "Sovereign country; key is ISO 3166-1 alpha-2."@en .

atlas:Document a owl:Class ;
    rdfs:label "تقرير"@ar,
        "خبر"@ar,
        "مستند"@ar,
        "Document"@en ;
    rdfs:comment "Unstructured source (news, contract text, report) linked to graph entities."@en .

atlas:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "Anything that can be bought, made, stocked or sold."@en .

atlas:SalesOrder a owl:Class ;
    rdfs:label "أمر بيع"@ar,
        "طلب"@ar,
        "طلبية"@ar,
        "SalesOrder"@en ;
    rdfs:comment "Customer order for a product."@en .

atlas:Material a owl:Class ;
    rdfs:label "مادة خام"@ar,
        "مواد خام"@ar,
        "Material"@en ;
    rdfs:comment "Raw or processed material (e.g. lithium carbonate, copper)."@en ;
